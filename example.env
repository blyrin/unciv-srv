# 监听端口
PORT=11451

# 数据库文件路径
DB_PATH='data/unciv-srv.db'

# 管理员配置
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='admin123'

# 网页登录限制
## 次数
MAX_ATTEMPTS=5
## 分钟
LOCK_TIME=5

# 注册与联机开关
## 注册模式：open 开放注册 / approval 新账号需管理员审核 / closed 只有预建账号可登录
REGISTER_MODE='open'
## 是否启用多人聊天（关闭后聊天不可用，存档同步与游戏更新推送不受影响）
CHAT_ENABLED=true
## IP 存储策略：full 存完整地址 / anonymized 只存网段 / none 不存
IP_STORAGE='anonymized'
## IP 保留天数（超过后自动清空 IP，0 表示不清理）
IP_RETENTION_DAYS=30

# 冷存档归档（存档总量超过上限后，从最久未使用的非白名单对局开始归档）
## 是否启用容量归档：true 先把最久未使用的对局写进归档文件再删数据库记录 / false 关闭
ARCHIVE_ENABLED=true
## 存档数据总量上限（MB，统计所有对局的存档正文与预览字节数）
ARCHIVE_MAX_MB=1024
## 归档目录（写 unciv-archive-<时间戳>Z.jsonl，建议放在 /data 下的挂载卷里）
ARCHIVE_DIR='data/archive'

# 安装包直链（UncivCN 社区下载服务器，不再托管安装包文件）
## 版本清单与安装包所在的 GitHub 仓库（owner/repo）
DOWNLOAD_GITHUB_REPO='AutumnPizazz/Unciv'
## GitHub 镜像前缀（替换 https://github.com/，大陆直连 GitHub release 不通；留空 = 直连）
DOWNLOAD_GITHUB_PROXY='https://mirror.ecrow.cn/github-release/'
