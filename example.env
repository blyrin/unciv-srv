# 监听端口
PORT=11451

# 数据库文件路径
DB_PATH='data/unciv-srv.db'

# 管理员配置
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='admin123'

# 网页登录限制
## 次数
MAX_ATTEMPTS=5
## 分钟
LOCK_TIME=5

# 安装包托管（CN 官方下载服务器）
## 托管根目录（容器内建议 /data/unciv-dl 并挂卷）
DOWNLOAD_DIR='data/unciv-dl'
## 下载保护：同时下载连接数上限
DOWNLOAD_MAX_CONCURRENT=4
## 单连接限速 KB/s（0 表示不限速）
DOWNLOAD_RATE_LIMIT_KBPS=1024
## 每 IP 每分钟下载请求上限（防刷）
DOWNLOAD_IP_LIMIT_PER_MINUTE=30
## 保留的最新版本数（上传新版本后自动清理旧版本目录）
DOWNLOAD_KEEP_VERSIONS=1
## 单个上传文件大小上限（MB）
DOWNLOAD_MAX_FILE_SIZE_MB=512

# 从 GitHub 同步安装包（POST /api/downloads/sync）
## 仓库（owner/repo）
DOWNLOAD_GITHUB_REPO='AutumnPizazz/Unciv'
## GitHub 代理/镜像前缀（大陆服务器直连 GitHub release 不通，留空 = 直连）
DOWNLOAD_GITHUB_PROXY='https://gh-proxy.com/'
